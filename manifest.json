{
  "manifest_version": 3,
  "name": "Teams Context Translator",
  "version": "0.8.3",
  "description": "Translates Microsoft Teams web chat messages with DeepSeek, using earlier messages as context.",
  "browser_specific_settings": {
    "gecko": {
      "id": "teams-context-translator@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["websiteContent", "personalCommunications"]
      }
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": ["storage", "clipboardWrite"],
  "host_permissions": [
    "https://api.deepseek.com/*",
    "https://teams.microsoft.com/*",
    "https://teams.cloud.microsoft/*",
    "https://teams.live.com/*"
  ],
  "background": {
    "scripts": ["settings.js", "text.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://teams.cloud.microsoft/*",
        "https://teams.live.com/*"
      ],
      "js": ["settings.js", "text.js", "selectors.js", "content.js", "send-confirm.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_icon": "icons/icon.svg",
    "default_title": "Teams 翻译设置",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
